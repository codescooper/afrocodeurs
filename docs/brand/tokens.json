{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": {
      "gold": { "$value": "#F5B800", "$type": "color" },
      "black": { "$value": "#111111", "$type": "color" },
      "green": { "$value": "#22C55E", "$type": "color" },
      "ivory": { "$value": "#FAFAF8", "$type": "color" },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "night": { "$value": "#0D0C0A", "$type": "color" }
    },
    "neutral": {
      "ink": { "$value": "#27271F", "$type": "color" },
      "stone": { "$value": "#5C5C54", "$type": "color" },
      "soft": { "$value": "#8B8B82", "$type": "color" },
      "border": { "$value": "#E6E4DD", "$type": "color" },
      "muted": { "$value": "#F1F0EC", "$type": "color" }
    },
    "state": {
      "success": { "$value": "#22C55E", "$type": "color" },
